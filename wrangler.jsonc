/**
 * Wrangler configuration for the seats.aero remote MCP server.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Stateless MCP via createMcpHandler() — no Durable Objects.
 *
 * Callers supply their own seats.aero Partner API key per-request via the
 * X-Seats-Aero-Api-Key header — no key is stored on the server.
 *
 * Optional secret (set with `wrangler secret put <NAME>`), only for a private
 * single-user deployment where callers should not need to send a key:
 *   SEATS_AERO_API_KEY  — fallback seats.aero Partner API key
 *
 * Optional vars (set below or in the dashboard) to restrict who can connect
 * via Cloudflare Access; while unset the server is public:
 *   ACCESS_TEAM_DOMAIN  — your Zero Trust team domain, e.g. "myteam"
 *   ACCESS_APP_AUD      — the Access application's Audience (AUD) tag
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seats-aero-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Keep the workers.dev URL as a secondary endpoint alongside the custom domain.
  "workers_dev": true,
  // mcp.joshuamarble.io is the shared hostname for all MCP servers. This
  // worker holds the hostname as a Custom Domain (auto-managed DNS + cert)
  // and serves its endpoint at BASE_PATH. Future MCP servers on the same
  // hostname claim `mcp.joshuamarble.io/<their-path>*` route patterns, which
  // take precedence over the Custom Domain.
  "routes": [
    {
      "pattern": "mcp.joshuamarble.io",
      "custom_domain": true
    }
  ],
  "vars": {
    // Path of this server's MCP endpoint on the shared hostname.
    "BASE_PATH": "/seats-aero"
    // Uncomment and fill in to require Cloudflare Access (server is public otherwise):
    // "ACCESS_TEAM_DOMAIN": "myteam",
    // "ACCESS_APP_AUD": "<aud tag from your Access application>"
  }
}
